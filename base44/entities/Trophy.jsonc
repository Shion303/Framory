{
  "name": "Trophy",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "condition_type": {
      "type": "string",
      "enum": [
        "complete_series"
      ],
      "default": "complete_series"
    },
    "condition_content_id": {
      "type": "string"
    },
    "condition_content_title": {
      "type": "string"
    },
    "is_unlocked": {
      "type": "boolean",
      "default": false
    },
    "unlocked_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "condition_type"
  ]
}