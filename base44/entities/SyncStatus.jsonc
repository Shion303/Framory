{
  "name": "SyncStatus",
  "type": "object",
  "properties": {
    "last_sync": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "running"
      ],
      "default": "success"
    },
    "summary": {
      "type": "string"
    },
    "contents_updated": {
      "type": "number"
    },
    "episodes_added": {
      "type": "number"
    },
    "seasons_updated": {
      "type": "number"
    }
  },
  "required": [
    "status"
  ]
}