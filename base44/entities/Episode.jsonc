{
  "name": "Episode",
  "type": "object",
  "properties": {
    "content_id": {
      "type": "string"
    },
    "season_number": {
      "type": "number"
    },
    "episode_number": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "airdate": {
      "type": "string"
    },
    "runtime": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "TVMAZE",
        "MANUAL"
      ],
      "default": "MANUAL"
    }
  },
  "required": [
    "content_id",
    "season_number",
    "episode_number"
  ]
}