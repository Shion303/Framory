{
  "name": "Season",
  "type": "object",
  "properties": {
    "content_id": {
      "type": "string"
    },
    "tvmaze_id": {
      "type": "number"
    },
    "season_number": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "episode_count": {
      "type": "number"
    },
    "poster_url": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "TVMAZE",
        "MANUAL"
      ],
      "default": "TVMAZE"
    }
  },
  "required": [
    "content_id",
    "season_number",
    "episode_count"
  ]
}